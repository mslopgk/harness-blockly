{
  "name": "blockpy-harness-playground",
  "version": "1.0.0",
  "description": "State-of-the-art Blockly-Python AST Harness Playground showcasing robust roundtrips, compiler desugaring, custom interpreters, and AI library abstractions.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "start": "concurrently \"npm run dev\" \"npm run server\"",
    "vendor": "node scripts/vendor-assets.cjs",
    "prebuild": "node scripts/vendor-assets.cjs",
    "build": "vite build",
    "electron": "electron .",
    "electron:dev": "vite build && electron .",
    "dist": "npm run build && node scripts/build-desktop.cjs",
    "test": "playwright test",
    "test:ir": "playwright test tests/ir_",
    "test:tm": "node --test tests/tm_pack.test.mjs",
    "test:terminal": "node --test tests/ai_terminal.test.mjs tests/xterm_url.test.mjs",
    "test:gen": "npm --prefix blockpy-gen test",
    "test:e2e": "playwright test tests/e2e.spec.js",
    "test:p0p1": "playwright test tests/test_p0_p1.spec.js",
    "test:p2p4": "playwright test tests/test_p2_p4.spec.js",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report test-results/report"
  },
  "keywords": [
    "blockly",
    "python",
    "ast",
    "interpreter",
    "desugarer",
    "compiler",
    "sandbox"
  ],
  "author": "Antigravity Agent",
  "license": "MIT",
  "build": {
    "appId": "com.blockpy.desktop",
    "productName": "BlockPy",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "server.js",
      "src/utils/**/*",
      "blockpy-gen/**/*",
      "agent-context/**/*",
      "runtime/**/*",
      "package.json",
      "!**/node_modules/pyodide/**",
      "!**/node_modules/blockly/**",
      "!**/node_modules/@fortawesome/**",
      "!**/node_modules/.cache/**",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "blockpy-gen/**/*",
      "node_modules/node-pty/**/*",
      "runtime/**/*"
    ],
    "extraResources": [
      {
        "from": "python-embed",
        "to": "python"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "BlockPy"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.60.0",
    "vite": "^8.0.14"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "blockly": "^13.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "prismjs": "^1.30.0",
    "pyodide": "^0.26.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ws": "^8.21.1"
  }
}
